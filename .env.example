# 复制本文件为 .env 后填入实际值。.env 已经被 .gitignore，永远不会进入仓库。

# ============================================================
# 必填：vault 绝对路径
# ============================================================
# Windows 示例: VAULT_PATH=C:\Users\you\Documents\SecondBrain
# macOS / Linux 示例: VAULT_PATH=/home/you/SecondBrain
VAULT_PATH=

# ============================================================
# LLM 提供方：remote 或 ollama
# ============================================================
LLM_PROVIDER=remote

# ============================================================
# 远程 LLM（OpenAI 兼容接口；OpenAI / 智谱 / DeepSeek / NVIDIA NIM / Kimi 等都可）
# ============================================================
REMOTE_API_KEY=
REMOTE_BASE_URL=https://api.openai.com/v1
REMOTE_MODEL_NAME=gpt-4o-mini

# 单次请求超时秒数
REMOTE_TIMEOUT=60

# 仅对超时 / 5xx / 429 / 408 等可重试错误生效，指数退避
REMOTE_MAX_RETRIES=3

# ============================================================
# 本地 Ollama（仅在 LLM_PROVIDER=ollama 时使用）
# ============================================================
OLLAMA_MODEL_NAME=qwen3:4b
